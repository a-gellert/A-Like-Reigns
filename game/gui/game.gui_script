local deck_engine = require("game.scripts.deck_engine")
local ads_bridge = require("game.scripts.ads_bridge")
local i18n = require("game.data.i18n")

local HASH_TOUCH = hash("touch")
local HASH_LEFT = hash("left")
local HASH_RIGHT = hash("right")
local HASH_KEY_A = hash("key_a")
local HASH_KEY_D = hash("key_d")
local HASH_KEY_SPACE = hash("key_space")

local DRAG_THRESHOLD = 100 -- Threshold in px as specified in GDD
local MAX_ROTATION_DEG = 15.0 -- 15 degrees max angle
local SCREEN_WIDTH = 480 -- Screen reference width

function init(self)
	msg.post(".", "acquire_input_focus")
	ads_bridge.init()

	self.engine = deck_engine.new()
	self.is_dragging = false
	self.touch_start_x = 0
	self.touch_start_y = 0
	self.card_offset_x = 0
	self.card_offset_y = 0
	self.card_base_pos = vmath.vector3(0, 30, 0)
	self.is_animating = false

	-- Cache GUI nodes
	self.nodes = {
		root = gui.get_node("root"),
		quarter_label = gui.get_node("quarter_label"),
		btn_lang = gui.get_node("btn_lang"),
		btn_lang_label = gui.get_node("btn_lang_label"),

		card_container = gui.get_node("card_container"),
		card = gui.get_node("card"),
		card_shadow = gui.get_node("card_shadow"),
		card_portrait = gui.get_node("card_portrait"),
		card_char_name = gui.get_node("card_char_name"),
		card_text = gui.get_node("card_text"),

		choice_overlay_left = gui.get_node("choice_overlay_left"),
		choice_text_left = gui.get_node("choice_text_left"),
		choice_overlay_right = gui.get_node("choice_overlay_right"),
		choice_text_right = gui.get_node("choice_text_right"),

		btn_left = gui.get_node("btn_left"),
		btn_left_label = gui.get_node("btn_left_label"),
		btn_right = gui.get_node("btn_right"),
		btn_right_label = gui.get_node("btn_right_label"),
		footer_hint = gui.get_node("footer_hint"),

		game_over_panel = gui.get_node("game_over_panel"),
		go_header = gui.get_node("go_header"),
		go_reason_title = gui.get_node("go_reason_title"),
		go_desc = gui.get_node("go_desc"),
		go_score = gui.get_node("go_score"),
		btn_revive = gui.get_node("btn_revive"),
		btn_revive_text = gui.get_node("btn_revive_text"),
		btn_restart = gui.get_node("btn_restart"),
		btn_restart_text = gui.get_node("btn_restart_text"),

		stats = {
			team = {
				val = gui.get_node("stat_team_val"),
				fill = gui.get_node("stat_team_bar_fill"),
				preview = gui.get_node("stat_team_bar_preview")
			},
			product = {
				val = gui.get_node("stat_product_val"),
				fill = gui.get_node("stat_product_bar_fill"),
				preview = gui.get_node("stat_product_bar_preview")
			},
			money = {
				val = gui.get_node("stat_money_val"),
				fill = gui.get_node("stat_money_bar_fill"),
				preview = gui.get_node("stat_money_bar_preview")
			},
			board = {
				val = gui.get_node("stat_board_val"),
				fill = gui.get_node("stat_board_bar_fill"),
				preview = gui.get_node("stat_board_bar_preview")
			}
		}
	}

	gui.set_enabled(self.nodes.game_over_panel, false)

	-- Start game
	self.engine:reset()
	update_ui_state(self)
end

function update_ui_state(self)
	local card = self.engine.current_card
	if not card then
		return
	end

	local cur_loc = i18n.get_current_locale()

	-- 1. Language Button & Quarters Label & Footer
	gui.set_text(self.nodes.btn_lang_label, cur_loc.short_name or string.upper(i18n.get_language()))
	gui.set_text(self.nodes.quarter_label, i18n.t("quarter", self.engine.quarters + 1))
	gui.set_text(self.nodes.footer_hint, i18n.t("footer_hint"))

	-- 2. Stats & Progress bars
	for stat_name, node_group in pairs(self.nodes.stats) do
		local val = math.max(0, math.min(100, self.engine.stats[stat_name] or 50))
		gui.set_text(node_group.val, tostring(val))
		-- bar width is 74 px max
		local fill_width = math.max(2, math.floor(74 * (val / 100)))
		gui.set_size(node_group.fill, vmath.vector3(fill_width, 8, 0))

		-- Color warnings if near death
		if val <= 20 or val >= 80 then
			gui.set_color(node_group.fill, vmath.vector4(0.95, 0.35, 0.35, 1.0))
		else
			gui.set_color(node_group.fill, vmath.vector4(0.30, 0.75, 0.95, 1.0))
		end
	end

	-- 3. Character Info & Portrait (Name only, without role)
	local char_info = self.engine:get_character_info(card.character)
	gui.set_text(self.nodes.card_char_name, char_info.name)
	gui.play_flipbook(self.nodes.card_portrait, char_info.sprite)

	-- 4. Dialogue Text & Localized Choices
	local card_text_data = i18n.get_card_text(card.id)
	gui.set_text(self.nodes.card_text, card_text_data.text)

	-- 5. Choices Previews
	gui.set_text(self.nodes.choice_text_left, card_text_data.left)
	gui.set_text(self.nodes.choice_text_right, card_text_data.right)

	-- 6. Buttons Labels
	gui.set_text(self.nodes.btn_left_label, card_text_data.left)
	gui.set_text(self.nodes.btn_right_label, card_text_data.right)

	-- Reset Card Transform
	gui.set_position(self.nodes.card_container, self.card_base_pos)
	gui.set_rotation(self.nodes.card_container, vmath.vector3(0, 0, 0))
	gui.set_color(self.nodes.choice_overlay_left, vmath.vector4(0.85, 0.25, 0.25, 0.0))
	gui.set_color(self.nodes.choice_overlay_right, vmath.vector4(0.20, 0.70, 0.35, 0.0))

	hide_telegraph_preview(self)
end

function hide_telegraph_preview(self)
	for stat_name, node_group in pairs(self.nodes.stats) do
		gui.set_size(node_group.preview, vmath.vector3(0, 8, 0))
		-- Restore fill to current stat value
		local val = math.max(0, math.min(100, self.engine.stats[stat_name] or 50))
		local fill_width = math.max(2, math.floor(74 * (val / 100)))
		gui.set_size(node_group.fill, vmath.vector3(fill_width, 8, 0))
	end
end

function update_telegraphing(self, dx)
	local card = self.engine.current_card
	if not card or math.abs(dx) < 15 then
		hide_telegraph_preview(self)
		return
	end

	local choice = (dx < 0) and card.left_choice or card.right_choice
	if not choice or not choice.effects then
		hide_telegraph_preview(self)
		return
	end

	local progress = math.min(1.0, math.abs(dx) / 80.0)

	for stat_name, node_group in pairs(self.nodes.stats) do
		local delta = choice.effects[stat_name]
		if delta and delta ~= 0 then
			local current_val = math.max(0, math.min(100, self.engine.stats[stat_name] or 50))
			local new_val = math.max(0, math.min(100, current_val + delta))
			local current_px = math.max(2, math.floor(74 * (current_val / 100)))
			local new_px = math.max(2, math.floor(74 * (new_val / 100)))

			if delta < 0 then
				-- Decrease: red preview at current width, shrink fill to reveal it
				gui.set_size(node_group.preview, vmath.vector3(current_px, 8, 0))
				gui.set_color(node_group.preview, vmath.vector4(0.95, 0.30, 0.30, 1.0))
				local lerped = current_px + (new_px - current_px) * progress
				gui.set_size(node_group.fill, vmath.vector3(math.max(2, lerped), 8, 0))
			else
				-- Increase: green preview extends beyond fill
				local lerped = current_px + (new_px - current_px) * progress
				gui.set_size(node_group.preview, vmath.vector3(math.max(2, lerped), 8, 0))
				gui.set_color(node_group.preview, vmath.vector4(0.20, 0.80, 0.35, 1.0))
				gui.set_size(node_group.fill, vmath.vector3(current_px, 8, 0))
			end
		else
			gui.set_size(node_group.preview, vmath.vector3(0, 8, 0))
		end
	end
end

function show_game_over(self)
	ads_bridge.gameplay_stop()
	gui.set_enabled(self.nodes.game_over_panel, true)
	gui.set_color(self.nodes.game_over_panel, vmath.vector4(0.03, 0.04, 0.07, 0.0))
	gui.animate(self.nodes.game_over_panel, gui.PROP_COLOR, vmath.vector4(0.03, 0.04, 0.07, 0.95), gui.EASING_OUTQUAD, 0.35)

	gui.set_text(self.nodes.go_header, i18n.t("game_over_header"))

	local death = self.engine.death_info
	if death and death.stat and death.type then
		local death_info = i18n.get_death(death.stat, death.type)
		gui.set_text(self.nodes.go_reason_title, death_info.title)
		gui.set_text(self.nodes.go_desc, death_info.desc)
	elseif death then
		gui.set_text(self.nodes.go_reason_title, death.title or i18n.t("game_over_default_title"))
		gui.set_text(self.nodes.go_desc, death.desc or i18n.t("game_over_default_desc"))
	else
		gui.set_text(self.nodes.go_reason_title, i18n.t("game_over_default_title"))
		gui.set_text(self.nodes.go_desc, i18n.t("game_over_default_desc"))
	end

	gui.set_text(self.nodes.go_score, i18n.t("game_over_score", self.engine.quarters))
	gui.set_text(self.nodes.btn_revive_text, i18n.t("btn_revive"))
	gui.set_text(self.nodes.btn_restart_text, i18n.t("btn_restart"))

	-- If rewarded ad was already used in this run, disable revive button
	if self.engine.ad_rewarded_used then
		gui.set_enabled(self.nodes.btn_revive, false)
	else
		gui.set_enabled(self.nodes.btn_revive, true)
	end
end

function commit_choice(self, direction)
	if self.is_animating or self.engine.is_game_over then
		return
	end

	self.is_animating = true
	hide_telegraph_preview(self)

	-- Fly out animation
	local target_x = (direction == "left") and -520 or 520
	local target_rot = (direction == "left") and 25 or -25
	local target_pos = vmath.vector3(target_x, self.card_base_pos.y, 0)

	gui.animate(self.nodes.card_container, gui.PROP_POSITION, target_pos, gui.EASING_INQUAD, 0.22, 0, function()
		local game_ended = self.engine:apply_choice(direction)
		if self.engine.is_game_over then
			self.is_animating = false
			show_game_over(self)
		else
			-- Spawn next card from top/fade-in
			gui.set_position(self.nodes.card_container, vmath.vector3(0, 180, 0))
			gui.set_rotation(self.nodes.card_container, vmath.vector3(0, 0, 0))
			gui.set_scale(self.nodes.card_container, vmath.vector3(0.85, 0.85, 1))
			update_ui_state(self)

			gui.animate(self.nodes.card_container, gui.PROP_POSITION, self.card_base_pos, gui.EASING_OUTBACK, 0.28)
			gui.animate(self.nodes.card_container, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.28, 0, function()
				self.is_animating = false
			end)
		end
	end)
end

function return_card_to_center(self)
	self.is_animating = true
	hide_telegraph_preview(self)
	gui.animate(self.nodes.choice_overlay_left, gui.PROP_COLOR, vmath.vector4(0.85, 0.25, 0.25, 0.0), gui.EASING_OUTQUAD, 0.18)
	gui.animate(self.nodes.choice_overlay_right, gui.PROP_COLOR, vmath.vector4(0.20, 0.70, 0.35, 0.0), gui.EASING_OUTQUAD, 0.18)
	gui.animate(self.nodes.card_container, gui.PROP_ROTATION, vmath.vector3(0, 0, 0), gui.EASING_OUTQUAD, 0.22)
	gui.animate(self.nodes.card_container, gui.PROP_POSITION, self.card_base_pos, gui.EASING_OUTQUAD, 0.22, 0, function()
		self.is_animating = false
	end)
end

function on_input(self, action_id, action)
	-- Start gameplay on the first player interaction
	if action.pressed and not self.engine.is_game_over then
		ads_bridge.gameplay_start()
	end

	-- Language Switcher interaction
	if action_id == HASH_TOUCH and action.pressed and not self.is_animating then
		if gui.pick_node(self.nodes.btn_lang, action.x, action.y) then
			i18n.cycle_language()
			update_ui_state(self)
			if self.engine.is_game_over then
				show_game_over(self)
			end
			return true
		end
	end

	-- 1. Game Over screen interactions
	if self.engine.is_game_over then
		if action_id == HASH_TOUCH and action.pressed then
			if gui.pick_node(self.nodes.btn_revive, action.x, action.y) and (not self.engine.ad_rewarded_used) then
				ads_bridge.rewarded_break(function(success)
					if success then
						self.engine:apply_rewarded_revive()
						gui.set_enabled(self.nodes.game_over_panel, false)
						ads_bridge.gameplay_start()
						update_ui_state(self)
					end
				end)
				return true
			elseif gui.pick_node(self.nodes.btn_restart, action.x, action.y) then
				-- Interstitial ad on restart
				if (self.engine.total_runs % 2) == 0 then
					ads_bridge.commercial_break(function()
						self.engine:reset()
						gui.set_enabled(self.nodes.game_over_panel, false)
						ads_bridge.gameplay_start()
						update_ui_state(self)
					end)
				else
					self.engine:reset()
					gui.set_enabled(self.nodes.game_over_panel, false)
					ads_bridge.gameplay_start()
					update_ui_state(self)
				end
				return true
			end
		end
		return false
	end

	-- 2. Desktop Keyboard & Buttons
	if not self.is_animating then
		if action.pressed then
			if action_id == HASH_LEFT or action_id == HASH_KEY_A then
				commit_choice(self, "left")
				return true
			elseif action_id == HASH_RIGHT or action_id == HASH_KEY_D then
				commit_choice(self, "right")
				return true
			end
		end
	end

	-- 3. Mouse / Touch click on Desktop Action Buttons below card
	if action_id == HASH_TOUCH and action.pressed and not self.is_animating then
		if gui.pick_node(self.nodes.btn_left, action.x, action.y) then
			commit_choice(self, "left")
			return true
		elseif gui.pick_node(self.nodes.btn_right, action.x, action.y) then
			commit_choice(self, "right")
			return true
		end
	end

	-- 4. Card Drag / Swipe Physics (Formula from GDD)
	if action_id == HASH_TOUCH and not self.is_animating then
		if action.pressed then
			if gui.pick_node(self.nodes.card, action.x, action.y) then
				self.is_dragging = true
				self.touch_start_x = action.x
				self.touch_start_y = action.y
				return true
			end
		elseif self.is_dragging then
			local dx = action.x - self.touch_start_x
			local dy = action.y - self.touch_start_y

			if action.released then
				self.is_dragging = false
				if math.abs(dx) >= DRAG_THRESHOLD then
					local dir = (dx < 0) and "left" or "right"
					commit_choice(self, dir)
				else
					return_card_to_center(self)
				end
				return true
			else
				-- GDD Formula: rotation = (dx / W_screen) * 15 deg
				local rot_z = -(dx / SCREEN_WIDTH) * MAX_ROTATION_DEG
				local pos_x = self.card_base_pos.x + dx
				local pos_y = self.card_base_pos.y + dy * 0.25 -- subtle vertical follow

				gui.set_position(self.nodes.card_container, vmath.vector3(pos_x, pos_y, 0))
				gui.set_rotation(self.nodes.card_container, vmath.vector3(0, 0, rot_z))

				-- Update choice badge alpha
				if dx < 0 then
					local left_alpha = math.min(1.0, math.abs(dx) / 100.0)
					gui.set_color(self.nodes.choice_overlay_left, vmath.vector4(0.85, 0.25, 0.25, left_alpha))
					gui.set_color(self.nodes.choice_overlay_right, vmath.vector4(0.20, 0.70, 0.35, 0.0))
				else
					local right_alpha = math.min(1.0, math.abs(dx) / 100.0)
					gui.set_color(self.nodes.choice_overlay_right, vmath.vector4(0.20, 0.70, 0.35, right_alpha))
					gui.set_color(self.nodes.choice_overlay_left, vmath.vector4(0.85, 0.25, 0.25, 0.0))
				end

				-- Telegraphing dots update
				update_telegraphing(self, dx)
				return true
			end
		end
	end

	return false
end
