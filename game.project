[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 480
height = 854
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[project]
title = Boss Simulator
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/heads/main.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/12.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip

[input]
game_binding = /input/game.input_bindingc
